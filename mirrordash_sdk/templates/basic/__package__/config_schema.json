{
  "$$schema": "http://json-schema.org/draft-07/schema#",
  "title": "$title",
  "description": "$description",
  "type": "object",
  "properties": {
    "interval": {
      "type": "integer",
      "default": 30,
      "title": "Update Interval (Seconds)",
      "description": "Time to wait between updates."
    },
    "show_header": {
      "type": "boolean",
      "default": true,
      "title": "Show Header",
      "description": "Show or hide the module's title."
    }
  },
  "required": ["interval", "show_header"]
}
